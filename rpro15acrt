# Transaction Data
transactions <- list(
 c("Milk","Bread","Butter"),
 c("Bread","Butter"),
 c("Milk","Bread"),
 c("Milk","Butter"),
 c("Bread","Butter","Eggs"),
 c("Milk","Bread","Butter"),
 c("Milk","Eggs"),
 c("Bread","Eggs"),
 c("Milk","Bread","Eggs"),
 c("Bread","Butter")
)
n <- length(transactions)
